#!/usr/bin/env python3
"""Non-destructive integrity validator for the Private Capital knowledge base.

Stage 1 validator.
- Reads repository JSON only.
- Never edits project data.
- Uses Python standard library only.
- Reports structural and cross-reference integrity problems.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import defaultdict
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent

ID_RE = re.compile(r"^[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*$")
CLAIM_RE = re.compile(r"^claim:[a-z0-9]+(?:-[a-z0-9]+)*$")
SOURCE_RE = re.compile(r"^source:[a-z0-9]+(?:-[a-z0-9]+)*$")
EVIDENCE_RE = re.compile(r"^evidence:[a-z0-9]+(?:-[a-z0-9]+)*$")
RESEARCH_RE = re.compile(r"^research:[a-z0-9]+(?:-[a-z0-9]+)*$")
RESEARCH_CLAIM_RE = re.compile(
    r"^research-claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
)

ENTITY_STATUSES = {"DRAFT", "REVIEW", "PUBLISHED", "ARCHIVED"}
CLAIM_STATUSES = {"VERIFIED", "SUPPORTED", "REPORTED", "DISPUTED"}
CONFIDENCES = {"HIGH", "MEDIUM", "LOW", "UNKNOWN"}
EVIDENCE_STRENGTHS = {"strong", "moderate", "weak"}


class Reporter:
    def __init__(self) -> None:
        self.errors: list[str] = []
        self.warnings: list[str] = []

    def error(self, message: str) -> None:
        self.errors.append(message)

    def warning(self, message: str) -> None:
        self.warnings.append(message)


def rel(path: Path) -> str:
    return path.relative_to(ROOT).as_posix()


def load_json(path: Path, report: Reporter) -> Any | None:
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except json.JSONDecodeError as exc:
        report.error(
            f"JSON_PARSE_ERROR | {rel(path)} | "
            f"line={exc.lineno} col={exc.colno} | {exc.msg}"
        )
    except OSError as exc:
        report.error(f"FILE_READ_ERROR | {rel(path)} | {exc}")
    return None


def all_json_files() -> list[Path]:
    return sorted(
        path
        for path in ROOT.rglob("*.json")
        if ".git" not in path.parts and "node_modules" not in path.parts
    )


def load_taxonomies(report: Reporter):
    entity_types: set[str] = set()
    relation_types: set[str] = set()
    relation_rules: dict[str, dict[str, set[str]]] = {}

    path = ROOT / "atlas/taxonomies/entity-types.json"
    data = load_json(path, report)
    if isinstance(data, dict):
        for item in data.get("entity_types", []):
            if isinstance(item, dict) and isinstance(item.get("id"), str):
                entity_types.add(item["id"])

    path = ROOT / "atlas/taxonomies/relation-types.json"
    data = load_json(path, report)
    if isinstance(data, dict):
        for item in data.get("relation_types", []):
            if isinstance(item, dict) and isinstance(item.get("id"), str):
                relation_types.add(item["id"])

    path = ROOT / "atlas/taxonomies/relation-rules.json"
    data = load_json(path, report)
    if isinstance(data, dict):
        for item in data.get("rules", []):
            if not isinstance(item, dict):
                continue

            relation = item.get("relation")
            if not isinstance(relation, str):
                continue

            relation_rules[relation] = {
                "subject_types": set(item.get("subject_types", [])),
                "object_types": set(item.get("object_types", [])),
            }

    return entity_types, relation_types, relation_rules


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Validate Private Capital Atlas integrity "
            "without modifying data."
        )
    )

    parser.add_argument(
        "--warnings-as-errors",
        action="store_true",
        help="Return exit code 2 when warnings exist.",
    )

    args = parser.parse_args()

    report = Reporter()

    files = all_json_files()
    parsed: dict[Path, Any] = {}

    for path in files:
        data = load_json(path, report)
        if data is not None:
            parsed[path] = data

    entity_types, relation_types, relation_rules = load_taxonomies(report)

    # ------------------------------------------------------------------
    # Canonical Entity Registry
    #
    # The current repository has two legitimate registry mechanisms:
    #
    # 1) atlas/entities/index.json contains registry summaries.
    # 2) atlas/entities/**/<slug>.json contains full entity records.
    #
    # The validator resolves both without modifying either one.
    # ------------------------------------------------------------------

    entities_by_id: dict[str, dict[str, Any]] = {}
    entity_paths: dict[str, list[Path]] = defaultdict(list)
    indexed_ids: set[str] = set()

    index_path = ROOT / "atlas/entities/index.json"
    index = parsed.get(index_path)

    if isinstance(index, dict):
        for item in index.get("entities", []):
            if not isinstance(item, dict):
                continue

            entity_id = item.get("id")

            if not isinstance(entity_id, str):
                report.error(
                    f"INDEX_ENTITY_ID_INVALID | "
                    f"{rel(index_path)} | {entity_id!r}"
                )
                continue

            if not ID_RE.fullmatch(entity_id):
                report.error(
                    f"ENTITY_ID_FORMAT_INVALID | "
                    f"{rel(index_path)} | {entity_id}"
                )

            indexed_ids.add(entity_id)

            # Registry summaries are sufficient for reference resolution.
            entities_by_id.setdefault(entity_id, item)

    entity_root = ROOT / "atlas/entities"

    for path in sorted(entity_root.rglob("*.json")):
        if path == index_path:
            continue

        data = parsed.get(path)

        if not isinstance(data, dict):
            continue

        entity_id = data.get("id")

        if not isinstance(entity_id, str):
            report.error(f"ENTITY_ID_MISSING | {rel(path)}")
            continue

        if not ID_RE.fullmatch(entity_id):
            report.error(
                f"ENTITY_ID_FORMAT_INVALID | {rel(path)} | {entity_id}"
            )

        if entity_id in entity_paths:
            report.error(
                f"DUPLICATE_ENTITY_FILE_ID | {entity_id} | "
                + " | ".join(
                    rel(existing) for existing in entity_paths[entity_id]
                )
                + f" | {rel(path)}"
            )

        entity_paths[entity_id].append(path)

        # Full entity file is authoritative when present.
        entities_by_id[entity_id] = data

        entity_type = data.get("type")

        if entity_type not in entity_types:
            report.error(
                f"ENTITY_TYPE_UNKNOWN | {rel(path)} | "
                f"{entity_id} | type={entity_type!r}"
            )

        if data.get("status") not in ENTITY_STATUSES:
            report.error(
                f"ENTITY_STATUS_INVALID | {rel(path)} | "
                f"{entity_id} | status={data.get('status')!r}"
            )

        name = data.get("name")

        if (
            not isinstance(name, dict)
            or not isinstance(name.get("fa"), str)
            or not isinstance(name.get("en"), str)
        ):
            report.error(
                f"ENTITY_NAME_INVALID | {rel(path)} | {entity_id}"
            )

        if entity_id.startswith("company:"):
            report.warning(
                f"LEGACY_NAMESPACE | {entity_id} | "
                "Organization entity currently uses company: namespace"
            )

        if entity_id not in indexed_ids:
            report.warning(
                f"ENTITY_NOT_IN_INDEX | {entity_id} | {rel(path)} | "
                "full entity file exists but registry index does not list it"
            )

    # ------------------------------------------------------------------
    # Canonical Claims
    # ------------------------------------------------------------------

    claims_by_id: dict[str, dict[str, Any]] = {}
    claim_paths: dict[str, Path] = {}

    claims_root = ROOT / "atlas/claims"

    for path in sorted(claims_root.glob("*.json")):
        data = parsed.get(path)

        if not isinstance(data, dict):
            continue

        claims = data.get("claims")

        if not isinstance(claims, list):
            report.error(f"CLAIMS_ARRAY_MISSING | {rel(path)}")
            continue

        owner = data.get("entity")

        if owner is not None and not isinstance(owner, str):
            report.error(
                f"CLAIMS_OWNER_INVALID | {rel(path)} | {owner!r}"
            )

        for claim in claims:
            if not isinstance(claim, dict):
                report.error(f"CLAIM_NOT_OBJECT | {rel(path)}")
                continue

            claim_id = claim.get("id")

            if (
                not isinstance(claim_id, str)
                or not CLAIM_RE.fullmatch(claim_id)
            ):
                report.error(
                    f"CLAIM_ID_INVALID | {rel(path)} | {claim_id!r}"
                )
                continue

            if claim_id in claims_by_id:
                report.error(
                    f"DUPLICATE_CLAIM_ID | {claim_id} | "
                    f"{rel(claim_paths[claim_id])} | {rel(path)}"
                )

            claims_by_id[claim_id] = claim
            claim_paths[claim_id] = path

            for required in (
                "subject",
                "predicate",
                "object",
                "status",
                "confidence",
            ):
                if required not in claim:
                    report.error(
                        f"CLAIM_REQUIRED_FIELD_MISSING | "
                        f"{claim_id} | {required} | {rel(path)}"
                    )

            subject = claim.get("subject")
            obj = claim.get("object")
            predicate = claim.get("predicate")

            if isinstance(subject, str) and subject not in entities_by_id:
                report.error(
                    f"CLAIM_SUBJECT_MISSING_ENTITY | "
                    f"{claim_id} | {subject} | {rel(path)}"
                )

            if isinstance(obj, str) and obj not in entities_by_id:
                report.error(
                    f"CLAIM_OBJECT_MISSING_ENTITY | "
                    f"{claim_id} | {obj} | {rel(path)}"
                )

            if predicate not in relation_types:
                report.error(
                    f"CLAIM_PREDICATE_UNKNOWN | "
                    f"{claim_id} | predicate={predicate!r} | {rel(path)}"
                )

            if claim.get("status") not in CLAIM_STATUSES:
                report.error(
                    f"CLAIM_STATUS_INVALID | "
                    f"{claim_id} | status={claim.get('status')!r}"
                )

            if claim.get("confidence") not in CONFIDENCES:
                report.error(
                    f"CLAIM_CONFIDENCE_INVALID | "
                    f"{claim_id} | confidence={claim.get('confidence')!r}"
                )

            if (
                isinstance(subject, str)
                and subject in entities_by_id
                and isinstance(obj, str)
                and obj in entities_by_id
                and isinstance(predicate, str)
            ):
                rule = relation_rules.get(predicate)

                if rule:
                    subject_type = entities_by_id[subject].get("type")
                    object_type = entities_by_id[obj].get("type")

                    if subject_type not in rule["subject_types"]:
                        report.error(
                            f"RELATION_SUBJECT_TYPE_VIOLATION | "
                            f"{claim_id} | {predicate} | "
                            f"actual={subject_type} | "
                            f"allowed={sorted(rule['subject_types'])}"
                        )

                    if object_type not in rule["object_types"]:
                        report.error(
                            f"RELATION_OBJECT_TYPE_VIOLATION | "
                            f"{claim_id} | {predicate} | "
                            f"actual={object_type} | "
                            f"allowed={sorted(rule['object_types'])}"
                        )

    # ------------------------------------------------------------------
    # Evidence + Sources
    # ------------------------------------------------------------------

    evidence_by_id: dict[str, dict[str, Any]] = {}
    source_by_id: dict[str, dict[str, Any]] = {}

    evidence_root = ROOT / "atlas/evidence"

    for path in sorted(evidence_root.glob("*.json")):
        data = parsed.get(path)

        if not isinstance(data, dict):
            continue

        for evidence in data.get("evidence", []):
            if not isinstance(evidence, dict):
                report.error(f"EVIDENCE_NOT_OBJECT | {rel(path)}")
                continue

            evidence_id = evidence.get("id")

            if (
                not isinstance(evidence_id, str)
                or not EVIDENCE_RE.fullmatch(evidence_id)
            ):
                report.error(
                    f"EVIDENCE_ID_INVALID | "
                    f"{rel(path)} | {evidence_id!r}"
                )
                continue

            if evidence_id in evidence_by_id:
                report.error(
                    f"DUPLICATE_EVIDENCE_ID | {evidence_id}"
                )

            evidence_by_id[evidence_id] = evidence

            claim_id = evidence.get("claim")

            if (
                not isinstance(claim_id, str)
                or claim_id not in claims_by_id
            ):
                report.error(
                    f"EVIDENCE_CLAIM_MISSING | "
                    f"{evidence_id} | claim={claim_id!r} | {rel(path)}"
                )

            if evidence.get("strength") not in EVIDENCE_STRENGTHS:
                report.error(
                    f"EVIDENCE_STRENGTH_INVALID | "
                    f"{evidence_id} | "
                    f"strength={evidence.get('strength')!r}"
                )

    source_root = ROOT / "atlas/sources"

    for path in sorted(source_root.glob("*.json")):
        data = parsed.get(path)

        if not isinstance(data, dict):
            continue

        records = data.get("sources")

        if isinstance(records, list):
            iterable = records
        else:
            iterable = [data]

        for source in iterable:
            if not isinstance(source, dict):
                report.error(f"SOURCE_NOT_OBJECT | {rel(path)}")
                continue

            source_id = source.get("id")

            if (
                not isinstance(source_id, str)
                or not SOURCE_RE.fullmatch(source_id)
            ):
                report.error(
                    f"SOURCE_ID_INVALID | "
                    f"{rel(path)} | {source_id!r}"
                )
                continue

            if source_id in source_by_id:
                report.error(
                    f"DUPLICATE_SOURCE_ID | {source_id}"
                )

            source_by_id[source_id] = source

            if source.get("type") != "Source":
                report.error(
                    f"SOURCE_TYPE_INVALID | "
                    f"{source_id} | type={source.get('type')!r}"
                )

            if not isinstance(source.get("title_fa"), str):
                report.error(
                    f"SOURCE_TITLE_MISSING | {source_id}"
                )

    for evidence_id, evidence in evidence_by_id.items():
        source_id = evidence.get("source")

        if (
            not isinstance(source_id, str)
            or source_id not in source_by_id
        ):
            report.error(
                f"EVIDENCE_SOURCE_MISSING | "
                f"{evidence_id} | source={source_id!r}"
            )

    evidenced_claims = {
        evidence.get("claim")
        for evidence in evidence_by_id.values()
        if isinstance(evidence.get("claim"), str)
    }

    for claim_id, path in claim_paths.items():
        if claim_id not in evidenced_claims:
            report.warning(
                f"CLAIM_WITHOUT_EVIDENCE | "
                f"{claim_id} | {rel(path)}"
            )

    # ------------------------------------------------------------------
    # Research cross-references
    # ------------------------------------------------------------------

    candidate_claims: dict[str, dict[str, Any]] = {}

    mappings_root = ROOT / "research/mappings"

    for path in sorted(mappings_root.glob("*.json")):
        data = parsed.get(path)

        if not isinstance(data, dict):
            continue

        for candidate in data.get("claims", []):
            if not isinstance(candidate, dict):
                continue

            candidate_id = candidate.get("id")

            if (
                not isinstance(candidate_id, str)
                or not RESEARCH_CLAIM_RE.fullmatch(candidate_id)
            ):
                report.error(
                    f"RESEARCH_CLAIM_ID_INVALID | "
                    f"{rel(path)} | {candidate_id!r}"
                )
                continue

            if candidate_id in candidate_claims:
                report.error(
                    f"DUPLICATE_RESEARCH_CLAIM_ID | {candidate_id}"
                )

            candidate_claims[candidate_id] = candidate

            research_id = candidate.get("researchId")

            if (
                not isinstance(research_id, str)
                or not RESEARCH_RE.fullmatch(research_id)
            ):
                report.error(
                    f"RESEARCH_ID_INVALID | "
                    f"{candidate_id} | {research_id!r}"
                )

            for field in ("sourceRefs", "evidenceRefs"):
                refs = candidate.get(field, [])

                if not isinstance(refs, list):
                    report.error(
                        f"RESEARCH_REF_LIST_INVALID | "
                        f"{candidate_id} | {field}"
                    )
                    continue

                for ref in refs:
                    if not isinstance(ref, str):
                        report.error(
                            f"RESEARCH_REF_INVALID | "
                            f"{candidate_id} | {field} | {ref!r}"
                        )
                    elif (
                        field == "sourceRefs"
                        and ref not in source_by_id
                    ):
                        report.error(
                            f"RESEARCH_SOURCE_MISSING | "
                            f"{candidate_id} | {ref}"
                        )
                    elif (
                        field == "evidenceRefs"
                        and ref not in evidence_by_id
                    ):
                        report.error(
                            f"RESEARCH_EVIDENCE_MISSING | "
                            f"{candidate_id} | {ref}"
                        )

    content_root = ROOT / "research/content"

    for path in sorted(content_root.glob("*.json")):
        data = parsed.get(path)

        if not isinstance(data, dict):
            continue

        for ref in data.get("candidateClaimRefs", []):
            if ref not in candidate_claims:
                report.error(
                    f"RESEARCH_CONTENT_CLAIM_REF_MISSING | "
                    f"{rel(path)} | {ref}"
                )

        for ref in data.get("claimRefs", []):
            if (
                isinstance(ref, str)
                and ref.startswith("claim:")
                and ref not in claims_by_id
            ):
                report.error(
                    f"RESEARCH_CANONICAL_CLAIM_REF_MISSING | "
                    f"{rel(path)} | {ref}"
                )

        for ref in data.get("sourceRefs", []):
            if (
                isinstance(ref, str)
                and ref not in source_by_id
            ):
                report.error(
                    f"RESEARCH_CONTENT_SOURCE_REF_MISSING | "
                    f"{rel(path)} | {ref}"
                )

        for ref in data.get("evidenceRefs", []):
            if (
                isinstance(ref, str)
                and ref not in evidence_by_id
            ):
                report.error(
                    f"RESEARCH_CONTENT_EVIDENCE_REF_MISSING | "
                    f"{rel(path)} | {ref}"
                )

        for section in data.get("sections", []):
            if not isinstance(section, dict):
                continue

            block_ids = {
                block.get("id")
                for block in section.get("content", [])
                if isinstance(block, dict)
            }

            for mention in section.get("mentions", []):
                if not isinstance(mention, dict):
                    continue

                mention_id = mention.get("id")
                block_id = mention.get("contentBlockId")

                if block_id and block_id not in block_ids:
                    report.error(
                        f"MENTION_BLOCK_MISSING | {rel(path)} | "
                        f"{mention_id} | block={block_id}"
                    )

                entity_ref = mention.get("entityRef")

                if (
                    isinstance(entity_ref, str)
                    and entity_ref not in entities_by_id
                    and not entity_ref.startswith("candidate:")
                ):
                    report.error(
                        f"MENTION_ENTITY_MISSING | "
                        f"{rel(path)} | {mention_id} | {entity_ref}"
                    )

                start = mention.get("start")
                end = mention.get("end")

                if (
                    isinstance(start, int)
                    and isinstance(end, int)
                    and end < start
                ):
                    report.error(
                        f"MENTION_RANGE_INVALID | "
                        f"{rel(path)} | {mention_id} | "
                        f"start={start} end={end}"
                    )

    # ------------------------------------------------------------------
    # Output
    # ------------------------------------------------------------------

    print("Private Capital — Stage 1 Integrity Validator")
    print("=" * 46)
    print(f"JSON files scanned : {len(files)}")
    print(f"Entities resolved  : {len(entities_by_id)}")
    print(f"Claims scanned     : {len(claims_by_id)}")
    print(f"Evidence scanned   : {len(evidence_by_id)}")
    print(f"Sources scanned    : {len(source_by_id)}")
    print(f"Candidate claims   : {len(candidate_claims)}")
    print()

    print(f"ERRORS   : {len(report.errors)}")

    for message in report.errors:
        print(f"  ✗ {message}")

    print()

    print(f"WARNINGS : {len(report.warnings)}")

    for message in report.warnings:
        print(f"  ! {message}")

    if report.errors:
        return 1

    if args.warnings_as_errors and report.warnings:
        return 2

    return 0


if __name__ == "__main__":
    sys.exit(main())
