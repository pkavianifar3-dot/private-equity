{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Atlas Entity Schema v1",
  "description": "Canonical data contract for Atlas entities.",
  "type": "object",

  "required": [
    "id",
    "type",
    "name",
    "lifecycleStatus"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "type": {
      "type": "string",
      "minLength": 1
    },

    "name": {
      "type": "object",
      "required": [
        "fa",
        "en"
      ],
      "properties": {
        "fa": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },

    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "honorific": {
      "type": "object",
      "properties": {
        "fa": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "PUBLISHED",
        "ARCHIVED"
      ]
    },

    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "additionalProperties": false
}
