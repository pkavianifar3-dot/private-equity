{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Atlas Schema v1",
  "description": "Core data contract for the Private Capital financial knowledge graph.",
  "type": "object",
  "required": [
  "id",
  "type",
  "name",
  "lifecycleStatus"
],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "required": ["fa", "en"],
      "properties": {
        "fa": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "honorific": {
      "type": "object",
      "properties": {
        "fa": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lifecycleStatus": {
  "type": "string",
  "enum": [
    "DRAFT",
    "REVIEW",
    "PUBLISHED",
    "ARCHIVED"
  ]
},
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
