{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Atlas Claim Schema v1",
  "type": "object",

  "required": [
    "id",
    "revision",
    "subject",
    "predicate",
    "status",
    "confidence"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "revision": {
      "type": "integer",
      "minimum": 1
    },

    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "transaction_time": {
      "type": "object",
      "required": [
        "recorded_at",
        "recorded_by"
      ],
      "properties": {
        "recorded_at": {
          "type": "string"
        },
        "recorded_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "subject": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "predicate": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },

    "object": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "value": {
      "$ref": "./value-schema-v1.json"
    },

    "temporal": {
      "type": "object",

      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },

        "end": {
          "type": [
            "string",
            "null"
          ]
        },

        "precision": {
          "type": "string"
        },

        "status": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "role": {
      "type": "string"
    },

    "context": {
      "type": "object",
      "additionalProperties": true
    },

    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "SUPPORTED",
        "REPORTED",
        "DISPUTED"
      ]
    },

    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },

    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence:[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },

    "last_reviewed": {
      "type": "string",
      "pattern": "^(13|14)\\d{2}-(0[1-9]|1[0-2])$"
    },

    "review_cycle_months": {
      "type": "integer",
      "minimum": 1
    },

    "claim_origin": {
      "type": "string",
      "enum": [
        "sourced",
        "internal_analysis"
      ]
    },

    "based_on": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },

    "authored_in": {
      "type": "string",
      "pattern": "^research:[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },

  "oneOf": [
    {
      "required": [
        "object"
      ],

      "not": {
        "required": [
          "value"
        ]
      }
    },

    {
      "required": [
        "value"
      ],

      "not": {
        "required": [
          "object"
        ]
      }
    }
  ],

  "additionalProperties": false,

  "allOf": [
    {
      "if": {
        "properties": {
          "claim_origin": {
            "const": "sourced"
          }
        },
        "required": [
          "claim_origin"
        ]
      },
      "then": {
        "required": [
          "evidenceRefs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "claim_origin": {
            "const": "internal_analysis"
          }
        },
        "required": [
          "claim_origin"
        ]
      },
      "then": {
        "required": [
          "based_on",
          "authored_in"
        ]
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "claim_origin"
          ]
        }
      },
      "then": {
        "required": [
          "evidenceRefs"
        ]
      }
    }
  ]
}
