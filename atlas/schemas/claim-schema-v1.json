{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Atlas Claim Schema v1",
  "type": "object",
  "required": [
    "id",
    "subject",
    "predicate",
    "object",
    "status",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "temporal": {
      "type": "object",
      "properties": {
        "start": {
          "type": ["string", "null"]
        },
        "end": {
          "type": ["string", "null"]
        },
        "precision": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "VERIFIED",
        "SUPPORTED",
        "REPORTED",
        "DISPUTED"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    }
  },
  "additionalProperties": false
}
