{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Atlas Structured Value Schema v1",
  "type": "object",

  "required": [
    "amount",
    "currency",
    "unit",
    "raw",
    "period_type"
  ],

  "properties": {
    "amount": {
      "type": "number"
    },

    "currency": {
      "type": "string"
    },

    "unit": {
      "type": "string",
      "enum": [
        "amount",
        "percentage",
        "count",
        "ratio"
      ]
    },

    "raw": {
      "type": "string"
    },

    "period_type": {
      "type": "string",
      "enum": [
        "point_in_time",
        "period",
        "as_of_date",
        "reported",
        "unknown"
      ]
    }
  },

  "additionalProperties": false
}
