{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Research Schema v2",
  "description": "Structured data contract for Research documents in the Private Capital knowledge system.",
  "type": "object",

  "required": [
  "id",
  "type",
  "schemaVersion",
  "url",
  "status",
  "title",
  "summary",
  "publication",
  "candidateClaimRefs",
  "sections"
],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^research:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "type": {
      "const": "Research"
    },

    "schemaVersion": {
      "const": "2.0"
    },

    "url": {
      "type": "string",
      "format": "uri-reference"
    },

    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "PUBLISHED",
        "ARCHIVED"
      ]
    },

    "title": {
      "$ref": "#/$defs/localizedText"
    },

    "summary": {
      "$ref": "#/$defs/localizedText"
    },

    "publication": {
      "type": "object",
      "properties": {
        "datePublished": {
          "type": [
            "string",
            "null"
          ]
        },
        "dateModified": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },

    "entityRefs": {
      "type": "array",
      "description": "References to canonical Atlas Entity IDs. Research does not duplicate Entity records.",
      "items": {
        "$ref": "#/$defs/atlasEntityRef"
      },
      "uniqueItems": true
    },

    "claimRefs": {
      "type": "array",
      "description": "References to canonical Atlas Claim IDs. Research does not duplicate Claim records.",
      "items": {
        "$ref": "#/$defs/claimRef"
      },
      "uniqueItems": true
    },
    "candidateClaimRefs": {
  "type": "array",
  "description": "References to research-level Candidate Claims that have not yet been promoted to the canonical Atlas.",
  "items": {
    "$ref": "#/$defs/candidateClaimRef"
  },
  "uniqueItems": true
},

    "evidenceRefs": {
      "type": "array",
      "description": "References to canonical Atlas Evidence IDs.",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      },
      "uniqueItems": true
    },

    "sourceRefs": {
      "type": "array",
      "description": "References to canonical Source IDs.",
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "uniqueItems": true
    },

    "relatedResearchRefs": {
      "type": "array",
      "description": "References to other Research documents.",
      "items": {
        "$ref": "#/$defs/researchRef"
      },
      "uniqueItems": true
    },

    "sections": {
      "type": "array",
      "description": "Ordered structured sections of the Research document.",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },

  "additionalProperties": false,

  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "fa": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "atlasEntityRef": {
  "type": "string",
  "pattern": "^(person|organization|company|investment|project|sector):[a-z0-9]+(?:-[a-z0-9]+)*$"
},

    "claimRef": {
      "type": "string",
      "pattern": "^claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
"candidateClaimRef": {
  "type": "string",
  "pattern": "^research-claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
},
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "sourceRef": {
      "type": "string",
      "pattern": "^source:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "researchRef": {
      "type": "string",
      "pattern": "^research:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "section": {
      "type": "object",

      "required": [
        "id",
        "title"
      ],

      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },

        "title": {
          "$ref": "#/$defs/localizedText"
        },

        "content": {
          "type": "array",
          "description": "Ordered content blocks belonging to this section.",
          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        },

        "entityRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atlasEntityRef"
          },
          "uniqueItems": true
        },

        "claimRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimRef"
          },
          "uniqueItems": true
        },

        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "uniqueItems": true
        },

        "mentions": {
          "type": "array",
          "description": "Semantic mentions found in this section.",
          "items": {
            "$ref": "#/$defs/mention"
          }
        }
      },

      "additionalProperties": false
    },

    "contentBlock": {
  "type": "object",

  "required": [
  "id",
  "type"
],

  "properties": {
"id": {
  "type": "string",
  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
},
    "type": {
      "type": "string",
      "enum": [
        "paragraph",
        "subheading",
        "figure",
        "list",
        "table"
      ]
    },

    "text": {
      "type": "string"
    },

    "caption": {
      "type": "string"
    },

    "src": {
      "type": "string"
    },

    "alt": {
      "type": "string"
    },

    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },

  "additionalProperties": false
},

    "mention": {
      "type": "object",

      "required": [
        "id",
        "text",
        "resolutionStatus"
      ],

      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },

        "text": {
          "type": "string"
        },

        "entityRef": {
  "anyOf": [
    {
      "$ref": "#/$defs/atlasEntityRef"
    },
    {
      "type": "null"
    }
  ]
},

"contentBlockId": {
  "type": "string",
  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
},

"resolutionStatus": {
          "type": "string",
          "enum": [
            "UNRESOLVED",
            "RESOLVED",
            "REJECTED"
          ]
        },

        "start": {
          "type": "integer",
          "minimum": 0
        },

        "end": {
          "type": "integer",
          "minimum": 0
        }
      },

      "additionalProperties": false
    }
  }
}
