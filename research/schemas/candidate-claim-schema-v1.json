{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Capital Candidate Claim Schema v1",
  "description": "Schema for research-level claims that have not yet been promoted to canonical Atlas claims.",
  "type": "object",

  "required": [
    "id",
    "researchId",
    "subject",
    "predicate",
    "object",
    "claimText",
    "status",
    "decision"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^research-claim:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "researchId": {
      "type": "string",
      "pattern": "^research:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "subject": {
      "$ref": "#/$defs/knowledgeRef"
    },

    "predicate": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },

    "object": {
      "anyOf": [
        {
          "$ref": "#/$defs/knowledgeRef"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeRef"
          },
          "minItems": 1
        }
      ]
    },

    "claimText": {
      "type": "string",
      "minLength": 1
    },

    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRef"
      },
      "uniqueItems": true
    },

    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      },
      "uniqueItems": true
    },

    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "ACCEPTED",
        "REJECTED",
        "PROMOTED"
      ]
    },

    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },

    "decision": {
      "type": "string",
      "enum": [
        "REVIEW",
        "ACCEPT",
        "REJECT",
        "PROMOTE_TO_ATLAS"
      ]
    },

    "notes": {
      "type": "string"
    }
  },

  "additionalProperties": false,

  "$defs": {
    "knowledgeRef": {
      "type": "string",
      "pattern": "^(candidate:[a-z0-9]+(?:-[a-z0-9]+)*|[a-z]+:[a-z0-9]+(?:-[a-z0-9]+)*)$"
    },

    "sourceRef": {
      "type": "string",
      "pattern": "^source:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence:[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
